# Server Configuration
PORT=5000

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas cluster connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/event_recommendation_db?retryWrites=true&w=majority

# JWT Secret Key for user & admin authentication
JWT_SECRET=super_secret_jwt_key_event_recommendation_2026

# ML Recommendation Service URL (Flask)
ML_SERVICE_URL=http://localhost:8000

# Default Initial Administrator Credentials (auto-seeded if no admin exists)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@eventai.com
ADMIN_PASSWORD=Admin@123
